{
	"version": 1,
	"base_image": "codeocean/python-slim-uv:main-5692e50",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "build-essential",
					"version": "12.12"
				},
				{
					"name": "libwavpack-dev",
					"version": "5.8.1-1"
				},
				{
					"name": "libwavpack1",
					"version": "5.8.1-1"
				},
				{
					"name": "tree",
					"version": "2.2.1-1"
				},
				{
					"name": "wavpack",
					"version": "5.8.1-1"
				}
			],
			"install_software_properties_common": true,
			"install_gnupg": true
		}
	}
}